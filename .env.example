# Copy this file to .env and replace ALL placeholder values with your actual credentials.
# NEVER commit your .env file to version control!

# Django settings
# Generate a secure key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-replace-this-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database configuration (MySQL)
DB_ENGINE=django.db.backends.mysql
DB_NAME=myapply
DB_USER=root
DB_PASSWORD=your_actual_mysql_password_here
DB_HOST=localhost
DB_PORT=3306

# OpenAI configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-with-your-actual-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Django-Q configuration (no Redis needed)
TAILORING_PENDING_TIMEOUT_MINUTES=5
TAILORING_PROCESSING_TIMEOUT_MINUTES=15

# Logging
LOG_LEVEL=INFO

# Optional integrations
# Get your Mapbox token from: https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=pk.replace-with-your-actual-mapbox-token-if-using-maps
